# انسخ الإعدادات نفسها الموجودة في Render إلى هذا الملف ثم احفظه
# (بعد النسخ أعد تسميته إلى .env)
TOKEN=ضع_توكن_البوت_هنا
CLIENT_ID=معرف_التطبيق
GUILD_ID=معرف_السيرفر
MONGODB_URI=mongodb://localhost:27017/fx9_dashboard
BOT_DEVELOPER_ID=
OWNER_ID=

# ─── اللوحة (Kratos Dashboard) ───
# نفس سر API_SECRET الموجود في الداشبورد — إلزامي، وبدونه لا تُقرأ أي بيانات.
API_SECRET=
# رابط الداشبورد العام — اختياري للدفع الفوري لسجلات ديسكورد إلى صفحة /logs
# وعكس تحديثات الأعضاء. اللوحة تسحب السجلات بنفسها من البوت حتى لو تُرك هذا
# فارغاً، لكن ضبطه يجعل الأحداث تظهر لحظياً.
DASHBOARD_URL=